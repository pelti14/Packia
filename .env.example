# ─── Supabase ───────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# Solo servidor: permite crear usuarios desde la app. Nunca exponerla en el navegador.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Project Settings → Database → Connection string
# App (pooler, puerto 6543)
DATABASE_URL="postgresql://postgres.TU-PROYECTO:CONTRASEÑA@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migraciones (conexión directa, puerto 5432)
DIRECT_URL="postgresql://postgres.TU-PROYECTO:CONTRASEÑA@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# ─── Seguridad ──────────────────────────────────────────────
# Clave para cifrar las credenciales de las tiendas (32 bytes en base64).
# Generar con: openssl rand -base64 32
ENCRYPTION_KEY=""

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SHOPIFY_API_VERSION="2025-07"

# ─── Etiquetas de envío ─────────────────────────────────────
# Sendcloud (Ajustes → Integraciones → Sendcloud API). Si está vacío, solo hay etiqueta interna Packia.
SENDCLOUD_PUBLIC_KEY=""
SENDCLOUD_SECRET_KEY=""
# Opcional: otra URL de la API (pruebas)
# SENDCLOUD_API_URL="https://panel.sendcloud.sc/api/v2"

# Remitente que aparece en las etiquetas
SENDER_NAME="Packia Fulfillment"
SENDER_ADDRESS="Calle del Almacén, 1"
SENDER_CITY="Madrid"
SENDER_ZIP="28001"
SENDER_COUNTRY="ES"
SENDER_PHONE="600000000"
SENDER_EMAIL="envios@packia.es"

# ─── Facturación (datos fiscales de Packia) ─────────────────
COMPANY_NAME="Packia Fulfillment S.L."
COMPANY_TAX_ID="B00000000"
COMPANY_ADDRESS="Calle del Almacén, 1 · 28001 Madrid"
COMPANY_EMAIL="facturacion@packia.es"
COMPANY_IBAN="ES00 0000 0000 0000 0000 0000"
