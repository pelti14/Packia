# ════════════════════════════════════════════════════════════
#  Packia · variables de entorno
#  Solo estas 6 son obligatorias. Todo lo demás (datos de empresa,
#  remitente, Sendcloud) se configura desde la app en Ajustes.
# ════════════════════════════════════════════════════════════

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="pega-aquí-la-clave-anon-o-publishable"
# ¡Secreta! Solo servidor. Clave service_role (o secret).
SUPABASE_SERVICE_ROLE_KEY="pega-aquí-la-clave-service_role-o-secret"

# Supabase → botón "Connect" → pestaña ORMs → Prisma (copia las dos líneas)
DATABASE_URL="postgresql://postgres.TU-PROYECTO:CONTRASEÑA@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.TU-PROYECTO:CONTRASEÑA@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Clave para cifrar las claves de las tiendas. Genérala en /setup
# o con: openssl rand -base64 32   (¡guárdala en un sitio seguro!)
ENCRYPTION_KEY=""

# ─── Opcionales ─────────────────────────────────────────────
# URL pública de la app (para enlaces de webhooks y emails). Ej: https://app.packia.es
NEXT_PUBLIC_APP_URL=""
# SHOPIFY_API_VERSION="2026-10"
# Sincronización automática de pedidos (por defecto cada 60 s; "off" para desactivarla)
# SYNC_INTERVAL_SECONDS="60"
# AUTO_SYNC="off"
# Respaldo con cron externo: GET https://tu-dominio/api/cron/sync?key=CRON_SECRET
# CRON_SECRET=""
# Valores por defecto si no se rellenan en Ajustes:
# COMPANY_NAME="" COMPANY_TAX_ID="" COMPANY_ADDRESS="" COMPANY_EMAIL="" COMPANY_IBAN=""
# SENDER_NAME="" SENDER_ADDRESS="" SENDER_CITY="" SENDER_ZIP="" SENDER_COUNTRY="ES" SENDER_PHONE="" SENDER_EMAIL=""
# SENDCLOUD_PUBLIC_KEY="" SENDCLOUD_SECRET_KEY=""
# SENDCLOUD_API_URL="https://panel.sendcloud.sc/api/v2"
