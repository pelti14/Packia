// Modelo de datos de Packia · PostgreSQL (Supabase).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// Conexión con pooler de Supabase (puerto 6543) para la app.
  url       = env("DATABASE_URL")
  /// Conexión directa (puerto 5432) para migraciones.
  directUrl = env("DIRECT_URL")
}

/// Perfil de un usuario de Supabase Auth: rol y, si es cliente, a qué empresa pertenece.
model Profile {
  /// Mismo id que auth.users en Supabase.
  id        String   @id
  email     String   @unique
  name      String?
  /// ADMIN | STAFF | CLIENT
  role      String   @default("STAFF")
  /// Notificaciones anteriores a esta fecha se consideran leídas.
  notificationsSeenAt DateTime?
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// Empresa a la que le hacemos la logística.
model Client {
  id                 String    @id @default(cuid())
  name               String
  contactEmail       String?
  taxId              String?
  billingAddress     String?
  /// ARRANQUE | CRECIMIENTO | ESCALA
  plan               String    @default("ARRANQUE")
  /// Pedidos incluidos en la cuota mensual.
  planOrders         Int       @default(300)
  /// Importes en céntimos, sin IVA.
  monthlyFeeCents    Int       @default(48000)
  extraOrderFeeCents Int       @default(140)
  returnFeeCents     Int       @default(150)
  /// Día en que empieza el servicio (si falta, se usa createdAt).
  serviceStartAt     DateTime?
  /// Semanas de prueba gratis desde serviceStartAt. Después se factura y el primer mes se prorratea.
  trialWeeks         Int       @default(0)
  /// Último día de servicio (baja confirmada). Después no se factura nada.
  serviceEndAt       DateTime?
  /// Elección de agencia: DEFAULT (la de por defecto) | CHEAPEST (más barata) | FASTEST (más rápida)
  shippingStrategy   String    @default("DEFAULT")
  /// Margen por envío sobre el coste de la agencia (céntimos). Vacío = el general de Ajustes.
  shippingMarkupCents Int?
  /// Experiencia del comprador: página de seguimiento y avisos con la marca de la tienda.
  trackingEnabled    Boolean   @default(false)
  /// Quién avisa al comprador: STORE (Shopify/Woo, como siempre) | KARGIA (emails con la marca de la tienda)
  notifyBuyer        String    @default("STORE")
  /// Avisos activados: RECEIVED,PACKED,SHIPPED,DELIVERED
  buyerEvents        String    @default("RECEIVED,PACKED,SHIPPED,DELIVERED")
  /// Marca de la tienda para el comprador final.
  publicName         String?
  /// Logo como data URL (máx. 300 KB).
  publicLogo         String?
  publicColor        String?
  publicReplyTo      String?
  publicMessage      String?
  /// Envío por defecto: "packia:GLS" (etiqueta interna) o "sendcloud:1402" (método de Sendcloud).
  defaultShipping    String?
  /// Cuenta de Sendcloud propia del cliente, con sus contratos de agencia (cifrado). Si está vacío se usa la de Packia.
  sendcloudPublicKey String?
  /// Cifrado (AES-256-GCM).
  sendcloudSecretKey String?
  createdAt          DateTime  @default(now())
  stores             Store[]
  products           Product[]
  orders             Order[]
  inbounds           Inbound[]
  returns            Return[]
  invoices           Invoice[]
  users              Profile[]
  customers          StoreCustomer[]
  notifications      Notification[]
  planChanges        PlanChange[]
  planRequests       PlanRequest[]
  invites            Invite[]
}

/// Tienda online conectada (Shopify o WooCommerce). Las credenciales se guardan cifradas.
model Store {
  id             String    @id @default(cuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// SHOPIFY | WOOCOMMERCE
  platform       String
  name           String
  /// Shopify: mitienda.myshopify.com · WooCommerce: https://mitienda.com
  domain         String
  /// Cifrado (AES-256-GCM). Shopify: token fijo (app antigua) o token temporal en caché (Dev Dashboard).
  accessToken    String?
  /// Shopify Dev Dashboard: Client ID (cifrado).
  shopifyClientId     String?
  /// Shopify Dev Dashboard: Client secret (cifrado). También firma los webhooks.
  shopifyClientSecret String?
  /// Caducidad del token temporal de Shopify (24 h).
  tokenExpiresAt DateTime?
  /// Cifrado (AES-256-GCM).
  consumerKey    String?
  /// Cifrado (AES-256-GCM).
  consumerSecret String?
  /// Cifrado (AES-256-GCM).
  webhookSecret  String?
  /// Tienda de demostración: no llama a ninguna API externa.
  isDemo         Boolean   @default(false)
  lastSyncAt     DateTime?
  /// Los productos se sincronizan con menos frecuencia que los pedidos.
  productsSyncedAt DateTime?
  lastSyncError  String?
  createdAt      DateTime  @default(now())
  orders         Order[]
  products       Product[]
  customers      StoreCustomer[]

  @@unique([platform, domain])
}

model Product {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  storeId     String?
  store       Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  externalId  String?
  sku         String
  name        String
  imageUrl    String?
  /// Stock físico en nuestro almacén.
  stock       Int      @default(0)
  /// Ubicación en estantería, p. ej. A-01-02.
  location    String?
  /// Por debajo de este stock se avisa al cliente.
  lowStockAt  Int      @default(10)
  weightGrams Int?
  /// Código de barras (EAN/UPC) para escanear en el picking.
  barcode     String?
  /// OK del equipo: hasta que no se valida, los pedidos con este producto no se pueden embalar.
  validatedAt DateTime?
  validatedBy String?
  updatedAt   DateTime @updatedAt

  @@unique([clientId, sku])
}

model Order {
  id              String      @id @default(cuid())
  clientId        String
  client          Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  storeId         String
  store           Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  externalId      String
  /// Número visible en la tienda (#1042).
  number          String
  /// PENDING | PICKING | PACKED | SHIPPED | CANCELLED
  status          String      @default("PENDING")
  customerName    String
  email           String?
  /// Dirección de envío normalizada (JSON).
  shippingAddress String
  carrier         String?
  trackingNumber  String?
  trackingUrl     String?
  /// PACKIA (etiqueta interna) | SENDCLOUD | MANUAL
  labelProvider   String?
  /// Id del envío en el proveedor de etiquetas.
  labelRef        String?
  weightGrams     Int?
  /// Cuándo se imprimió la etiqueta por última vez (null = en «Etiquetas por imprimir»).
  labelPrintedAt  DateTime?
  labelPrintCount Int         @default(0)
  /// Servicio de transporte elegido y lo que cuesta (agencia) y se cobra (cliente), en céntimos.
  carrierServiceId    String?
  carrierService      CarrierService? @relation(fields: [carrierServiceId], references: [id], onDelete: SetNull)
  shippingCostCents   Int?
  shippingChargeCents Int?
  /// Enlace público de seguimiento para el comprador (/seguimiento/<token>).
  trackingToken   String?     @unique
  /// Último estado informado por la agencia y fecha de entrega.
  carrierStatus   String?
  deliveredAt     DateTime?
  /// Error al devolver el seguimiento a la tienda, si lo hubo.
  syncError       String?
  placedAt        DateTime
  shippedAt       DateTime?
  createdAt       DateTime    @default(now())
  items           OrderItem[]
  returns         Return[]
  messages        MessageLog[]

  @@unique([storeId, externalId])
  @@index([status])
  @@index([clientId, shippedAt])
  @@index([labelPrintedAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  externalLineId String?
  sku            String
  name           String
  quantity       Int
}

/// Recepción: mercancía que el cliente nos envía al almacén.
model Inbound {
  id         String        @id @default(cuid())
  clientId   String
  client     Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Referencia del cliente (albarán, nº de pedido al proveedor…).
  reference  String
  carrier    String?
  boxes      Int?
  notes      String?
  /// EXPECTED | RECEIVED
  status     String        @default("EXPECTED")
  expectedAt DateTime?
  receivedAt DateTime?
  createdAt  DateTime      @default(now())
  items      InboundItem[]

  @@index([status])
}

model InboundItem {
  id          String  @id @default(cuid())
  inboundId   String
  inbound     Inbound @relation(fields: [inboundId], references: [id], onDelete: Cascade)
  sku         String
  name        String
  expectedQty Int
  receivedQty Int?
  /// Unidades recibidas dañadas (no entran a stock).
  damagedQty  Int     @default(0)
}

/// Devolución de un cliente final.
model Return {
  id          String       @id @default(cuid())
  clientId    String
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reason      String?
  /// ANNOUNCED | RECEIVED | PROCESSED
  status      String       @default("ANNOUNCED")
  receivedAt  DateTime?
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  items       ReturnItem[]

  @@index([status])
}

model ReturnItem {
  id        String  @id @default(cuid())
  returnId  String
  return    Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  sku       String
  name      String
  quantity  Int
  /// RESTOCK (vuelve a stock) | DAMAGED (no vendible) · se decide al procesar.
  condition String?
}

/// Factura mensual de un cliente.
model Invoice {
  id            String        @id @default(cuid())
  /// KG-2026-0001 (normal) o KGR-2026-0001 (rectificativa)
  number        String        @unique
  /// INVOICE (normal) | CORRECTIVE (rectificativa, importes en negativo)
  kind          String        @default("INVOICE")
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodStart   DateTime
  periodEnd     DateTime
  /// ISSUED | PAID | CANCELLED (anulada con su rectificativa)
  status        String        @default("ISSUED")
  subtotalCents Int
  taxRate       Int           @default(21)
  taxCents      Int
  totalCents    Int
  issuedAt      DateTime      @default(now())
  paidAt        DateTime?
  cancelledAt   DateTime?
  /// Motivo de la rectificación o anulación.
  reason        String?
  /// Rectificativa → factura que anula.
  correctsId    String?
  corrects      Invoice?      @relation("Corrections", fields: [correctsId], references: [id])
  corrections   Invoice[]     @relation("Corrections")
  /// Factura corregida → factura a la que sustituye.
  replacesId    String?
  replaces      Invoice?      @relation("Replacements", fields: [replacesId], references: [id])
  replacements  Invoice[]     @relation("Replacements")
  lines         InvoiceLine[]

  @@index([clientId, periodStart])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int
  unitPriceCents Int
  amountCents    Int
}

/// Ajustes de la empresa editables desde la app (una sola fila, id = "default").
model AppSettings {
  id                 String   @id @default("default")
  companyName        String?
  companyTaxId       String?
  companyAddress     String?
  companyEmail       String?
  companyIban        String?
  senderName         String?
  senderAddress      String?
  senderCity         String?
  senderZip          String?
  senderCountry      String?
  senderPhone        String?
  senderEmail        String?
  /// Cifrado (AES-256-GCM).
  sendcloudPublicKey String?
  /// Cifrado (AES-256-GCM).
  sendcloudSecretKey String?
  /// Emitir solo las facturas del mes anterior los días 1-5 de cada mes.
  autoInvoice        Boolean  @default(true)
  /// Margen por envío por defecto sobre el coste de la agencia (céntimos).
  shippingMarkupCents Int     @default(40)
  /// Permitir que cualquier tienda se dé de alta sola desde /alta (sin invitación).
  openSignup         Boolean  @default(false)
  /// Semanas de prueba para las altas por invitación o autoservicio.
  defaultTrialWeeks  Int      @default(2)
  /// Serie de facturación: KG → KG-2026-0001 y rectificativas KGR-2026-0001.
  invoicePrefix      String   @default("KG")
  /// Impresora de etiquetas: THERMAL_100x150 | THERMAL_4x6 | A4_4 | A4_1
  printFormat        String   @default("THERMAL_100x150")
  /// Ajuste fino en milímetros (positivo = derecha / arriba).
  printOffsetX       Float    @default(0)
  printOffsetY       Float    @default(0)
  /// Escala en % (100 = tamaño real).
  printScale         Int      @default(100)
  /// Girar 180° (impresoras que sacan la etiqueta al revés).
  printRotate180     Boolean  @default(false)
  /// Imprimir cada etiqueta en el momento de embalar (va directa a su caja).
  printOnPack        Boolean  @default(true)
  /// Abrir el diálogo de impresión al abrir el PDF.
  printAutoDialog    Boolean  @default(true)
  /// Orden de las etiquetas: CLIENT (cliente y pedido) | CARRIER (agencia) | TIME (hora de envío)
  printSort          String   @default("CARRIER")
  /// Marca comercial que se ve en toda la app y en la web (por defecto «Packia»).
  brandName          String?
  /// Texto bajo el nombre (por defecto «fulfillment»).
  brandTagline       String?
  /// Logo como data URL (png, jpg, webp o svg; máx. 300 KB).
  brandLogo          String?
  /// Contacto público (web, landing y app): WhatsApp con prefijo, sin + ni espacios.
  contactWhatsapp    String?
  contactPhone       String?
  contactEmail       String?
  updatedAt          DateTime @updatedAt
}

/// Cliente final de una tienda (quien compra), guardado a partir de sus pedidos.
model StoreCustomer {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Email en minúsculas o, si no hay, nombre + código postal.
  key          String
  name         String
  email        String?
  phone        String?
  address1     String?
  address2     String?
  city         String?
  zip          String?
  province     String?
  country      String?
  ordersCount  Int      @default(0)
  firstOrderAt DateTime
  lastOrderAt  DateTime

  @@unique([storeId, key])
  @@index([clientId])
}

/// Avisos para la campana de notificaciones.
model Notification {
  id        String   @id @default(cuid())
  /// Cliente al que se refiere (si lo hay).
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// STAFF: solo equipo · ALL: también el cliente afectado.
  audience  String   @default("STAFF")
  /// info | success | warning | danger
  tone      String   @default("info")
  title     String
  body      String?
  href      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Cerrojo para que la sincronización automática no se ejecute dos veces a la vez.
model SyncLock {
  id          String   @id
  lockedUntil DateTime
  lastRunAt   DateTime?
}

/// Planes de precios editables en Ajustes (se copian al cliente al elegirlos).
model PlanConfig {
  /// ARRANQUE | CRECIMIENTO | ESCALA
  key        String   @id
  label      String
  orders     Int
  feeCents   Int
  extraCents Int
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

/// Historial de cambios de condiciones de un cliente, para prorratear por días.
model PlanChange {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Desde cuándo valen las nuevas condiciones (00:00 de Madrid).
  effectiveAt    DateTime
  fromPlan       String
  fromOrders     Int
  fromFeeCents   Int
  fromExtraCents Int
  toPlan         String
  toOrders       Int
  toFeeCents     Int
  toExtraCents   Int
  /// ADMIN | CLIENT | SETTINGS
  source         String
  createdBy      String?
  createdAt      DateTime @default(now())

  @@index([clientId, effectiveAt])
}

/// Peticiones del cliente (subir, bajar, baja) y cambios programados.
model PlanRequest {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// UPGRADE | DOWNGRADE | CANCEL | CHANGE
  type        String
  /// Plan de destino (UPGRADE, DOWNGRADE, CHANGE).
  plan        String?
  /// Condiciones de destino para CHANGE programado por un administrador.
  orders      Int?
  feeCents    Int?
  extraCents  Int?
  /// Fecha de efecto. En CANCEL es el último día de servicio.
  effectiveAt DateTime
  /// PENDING | APPLIED | REJECTED | WITHDRAWN
  status      String    @default("PENDING")
  note        String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?

  @@index([status, effectiveAt])
}

/// Servicio de transporte con su tarifa de coste por zona y peso (para elegir la agencia automáticamente).
model CarrierService {
  id             String   @id @default(cuid())
  /// «GLS Business 24h»
  name           String
  /// GLS, SEUR, Correos Express…
  carrier        String
  /// Cómo se crea la etiqueta: "packia:GLS" (interna) o "sendcloud:1402" (método de Sendcloud)
  labelMethod    String
  /// Días laborables de tránsito (para «la más rápida»).
  transitDays    Int      @default(1)
  maxWeightGrams Int      @default(30000)
  /// Coste en céntimos por zona y tramo de peso: { "ES": { "1000": 390, "2000": 420 }, "BAL": {…} }
  rates          Json
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]
}

/// Invitación para que una tienda se dé de alta sola.
model Invite {
  id          String    @id @default(cuid())
  token       String    @unique
  email       String?
  companyName String?
  plan        String?
  trialWeeks  Int?
  createdBy   String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

/// Estado temporal de una conexión en un clic (Shopify OAuth / WooCommerce wc-auth).
model OAuthState {
  /// Valor aleatorio que viaja a la tienda y vuelve (anti-CSRF).
  id        String    @id
  /// SHOPIFY | WOOCOMMERCE
  kind      String
  clientId  String
  domain    String
  createdAt DateTime  @default(now())
  usedAt    DateTime?
}

/// Avisos enviados al comprador final (evita duplicados y deja historial).
model MessageLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// RECEIVED | PACKED | SHIPPED | DELIVERED | TEST
  event     String
  /// EMAIL
  channel   String   @default("EMAIL")
  to        String
  /// SENT | FAILED | SKIPPED
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@unique([orderId, event, channel])
}
